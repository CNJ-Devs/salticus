{
  "name": "salticus",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Play locally. Watch together. An open-source P2P watch-together tool.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node companion/cli.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "desktop:dev": "electron .",
    "desktop:package": "npm run build && electron-builder --mac dmg zip --arm64 --x64"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.4"
  },
  "main": "desktop/main.mjs",
  "author": "CNJ-Devs",
  "build": {
    "appId": "com.cnjdevs.salticus",
    "productName": "Salticus",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**/*",
      "companion/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "dist/extension",
        "to": "extension"
      },
      {
        "from": "desktop/native-client.cjs",
        "to": "native-client.cjs"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.social-networking",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "Salticus",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 430,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "Salticus-${version}-${arch}.${ext}",
    "publish": null
  }
}
